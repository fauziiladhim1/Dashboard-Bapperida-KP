# Salin ke .env lalu isi. JANGAN commit .env.
NODE_ENV=development
PORT=4000
POSTGRES_USER=sipwil
POSTGRES_PASSWORD=ganti-password-kuat
POSTGRES_DB=sipwil
DB_PORT=5433
DATABASE_URL=postgres://sipwil:ganti-password-kuat@localhost:5433/sipwil
# Minimal 32 karakter acak: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
UPLOAD_DIR=uploads
# Dev (API dijalankan langsung): 0. Produksi lewat compose memakai PROD_TRUST_PROXY (default 1), lihat docs/DEPLOY.md
TRUST_PROXY=0
# Akun superadmin awal (dibuat npm run db:seed). Password akun ini dikelola dari sini: API menyamakan hash di DB
# dengan SEED_ADMIN_PASSWORD setiap start, dan form ganti password di aplikasi dikunci untuk akun ini.
SEED_ADMIN_EMAIL=admin@kulonprogokab.go.id
SEED_ADMIN_PASSWORD=ganti-password-admin-kuat
# Produksi: perbarui layer potensi-bencana dari InaRISK BNPB bila salinannya > 30 hari (cek tiap 24 jam). false = matikan.
INARISK_AUTO=true
