{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('public/vendor',{recursive:true});for(const f of ['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])fs.copyFileSync(require.resolve('maplibre-gl/dist/'+f),'public/vendor/'+f)\"",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
