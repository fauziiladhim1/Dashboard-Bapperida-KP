{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:migrate": "tsx --env-file=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file=../../.env src/db/cli.ts seed",
    "db:admin-password": "tsx --env-file=../../.env src/db/cli.ts admin-password",
    "db:import": "tsx --env-file=../../.env src/db/import.ts",
    "db:inarisk": "tsx --env-file=../../.env src/db/inarisk.ts"
  },
  "dependencies": {
    "@mapbox/shp-write": "^0.4.3",
    "@node-rs/argon2": "^2.2.2",
    "but-unzip": "^0.1.10",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "geotiff": "^3.0.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "multer": "^2.5.0",
    "postgres": "^4.0.0",
    "read-excel-file": "^9.3.14",
    "sharp": "^0.35.5",
    "shpjs": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jszip": "^3.10.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
